{
  "name": "questlog",
  "private": true,
  "version": "0.1.0",
  "description": "Questlog for the desktop: fills in application forms and runs Claude Code, Codex or OpenCode as its agent.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/happylemonprogramming/questlog",
  "repository": {
    "type": "git",
    "url": "https://github.com/happylemonprogramming/questlog.git"
  },
  "main": "build/main.cjs",
  "desktopName": "questlog.desktop",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.90.0",
    "@agentclientprotocol/codex-acp": "^2.2.2",
    "@agentclientprotocol/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "isomorphic-git": "^1.44.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "build:main": "esbuild src/main.ts src/preload.ts src/mcp-bridge.ts --bundle --platform=node --target=node22 --format=cjs --outdir=build --out-extension:.js=.cjs --external:electron --log-level=warning",
    "build:web": "npm --prefix .. run build && rm -rf web && cp -r ../dist web",
    "typecheck": "tsc -p .",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build:main && electron .",
    "dist": "npm run build:web && npm run build:main && electron-builder"
  },
  "build": {
    "appId": "io.github.happylemonprogramming.questlog",
    "productName": "Questlog",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "build/**",
      "web/**",
      "package.json",
      "!node_modules/@openai/codex-*/**",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "build/mcp-bridge.cjs",
      "node_modules/@agentclientprotocol/**",
      "node_modules/@openai/**",
      "node_modules/@anthropic-ai/**"
    ],
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "questlog",
      "artifactName": "${productName}-linux-${arch}.${ext}",
      "category": "Office",
      "extraResources": [
        {
          "from": "resources/icon.png",
          "to": "icon.png"
        },
        {
          "from": "resources/icon.svg",
          "to": "icon.svg"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-mac-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-win-${arch}.${ext}"
    }
  }
}
